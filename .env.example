# Bachs sandbox. For production: BACHS_ENVIRONMENT=production and an sk_live_
# key, after you replace the local store (see README).
BACHS_ENVIRONMENT=sandbox
BACHS_API_KEY=sk_sandbox_...

# Printed by `npm run listen` for local development. In production, use the
# signing secret of the webhook endpoint you register in the dashboard.
BACHS_WEBHOOK_SECRET=whsec_...

# Printed by `npm run setup:products`.
BACHS_PRODUCT_GUIDE=prod_...
BACHS_PRODUCT_PACK=prod_...

# Optional. Bachs refuses localhost and private addresses for checkout
# redirects, so leave these empty for local development and return to the
# store yourself. On a public deployment, point the success URL at your store.
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
